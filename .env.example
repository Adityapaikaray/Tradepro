# ==============================================================================
# TradePro Environment Variables & Credentials Template
# Set these from your active Supabase project. Do not copy credentials from another project.
# ==============================================================================

# Real-time Stock API Key (Twelve Data recommended)
VITE_TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ------------------------------------------------------------------------------
# Supabase Authentication (Free Tier / Official Client)
# Get the Project URL and publishable key from: Supabase Dashboard -> Project Settings -> API
# 
# SECURITY WARNING:
# 1. Use ONLY the public publishable/anon key on the frontend (VITE_ prefix).
# 2. NEVER put the database connection string (postgresql://...) in frontend code.
# 3. NEVER put the PostgreSQL password into the repository.
# 4. NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser or prefix it with VITE_.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Legacy alternative if the project still uses the anon key:
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# Server-Side Only Credentials (NEVER expose to browser / NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
